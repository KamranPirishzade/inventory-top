  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/app.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && npm run build:css",
    "start": "node dist/app.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/output.css --minify",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./public/output.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "pg": "^8.23.1"
  }
