<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Item Detail</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body class="p-4">
    <% if (item) { %>
        <h1 class="text-2xl font-bold"><%= item.name %> <i>by <%= item.brand_name %></i></h1>
        <img src="<% if (item.img_url) { %><%= item.img_url %><% } else { %>/images/default.png<% } %>" alt="<%= item.name %>" width="300" height="300">
        <p><strong>Price:</strong> $<%= item.price %></p>
        <p><strong>Availability:</strong> <%= item.stock > 0 ? 'In Stock(' + item.stock + ')' : 'Out of Stock' %></p>
        <p><strong>Description:</strong> <%= item.description %></p>
        <p><strong>Category:</strong> <%= item.category_id %></p>
    <% } else { %>
        <h1>Item not found</h1>
        <p>The item you are looking for does not exist.</p>
    <% } %>
</body>
</html>