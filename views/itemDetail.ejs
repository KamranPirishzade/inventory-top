<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= item.name %> · FigureStore</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="page">
      <a href="/items" class="btn-link">&larr; Back to inventory</a>

      <article class="card mt-4 grid gap-8 overflow-hidden md:grid-cols-2">
        <div class="flex aspect-square items-center justify-center bg-gray-100">
          <img
            src="<% if (item.img_url) { %><%= item.img_url %><% } else { %>/images/default.png<% } %>"
            alt="<%= item.name %>"
            class="h-full w-full object-contain p-8"
            onerror="this.src = '/images/default.png'"
          />
        </div>

        <div class="flex flex-col gap-5 p-6 md:py-8 md:pr-8 md:pl-0">
          <div>
            <p class="text-sm text-gray-500"><%= item.brand_name %></p>
            <h1 class="mt-1 text-3xl font-bold text-gray-900"><%= item.name %></h1>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-3xl font-bold text-gray-900">$<%= item.price %></span>
            <% if (item.stock > 0) { %>
              <span class="badge badge-success">In stock (<%= item.stock %>)</span>
            <% } else { %>
              <span class="badge badge-danger">Out of stock</span>
            <% } %>
          </div>

          <p class="leading-relaxed text-gray-600">
            <%= item.description || 'No description yet.' %>
          </p>

          <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-t border-gray-200 pt-5 text-sm">
            <dt class="text-gray-500">Category</dt>
            <dd>
              <a href="/items?category_id=<%= item.category_id %>" class="btn-link"><%= item.category_name %></a>
            </dd>
            <dt class="text-gray-500">Brand</dt>
            <dd class="text-gray-800"><%= item.brand_name %></dd>
          </dl>

          <div class="mt-auto flex flex-wrap gap-3 pt-2">
            <a href="/items/<%= itemId %>/update" class="btn btn-primary">Edit item</a>
            <form action="/items/<%= itemId %>/delete" method="POST">
              <button
                type="submit"
                class="btn btn-danger"
                onclick="return confirm('Are you sure you want to delete this item?')"
              >Delete item</button>
            </form>
          </div>
        </div>
      </article>
    </main>
  </body>
</html>
