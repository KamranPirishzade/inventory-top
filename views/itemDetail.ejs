<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Item Detail</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body class="p-4">
    <%- include('partials/header') %>
    <a href="/items" class="text-blue-500 hover:underline">Back</a>
    <h1 class="text-2xl font-bold">
      <%= item.name %> <i>by <%= item.brand_name %></i>
    </h1>
    <img
      src="<% if (item.img_url) { %><%= item.img_url %><% } else { %>/images/default.png<% } %>"
      alt="<%= item.name %>"
      width="300"
      height="300"
      onerror="this.src = '/images/default.png'"
    />
    <p><strong>Price:</strong> $<%= item.price %></p>
    <p>
      <strong>Availability:</strong> <%= item.stock > 0 ? 'In Stock(' +
      item.stock + ')' : 'Out of Stock' %>
    </p>
    <p><strong>Description:</strong> <%= item.description %></p>
    <p>
      <strong>Category:</strong>
      <a
        href="/items?category_id=<%= item.category_id %>"
        class="text-blue-500 hover:underline"
        ><%= item.category_name %></a
      >
    </p>
    <div class="mt-4 flex gap-2">
      <a
        href="/items/<%= itemId %>/update"
        class="bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-600"
        >Edit Item</a
      >
      <form action="/items/<%= itemId %>/delete" method="POST">
        <button
          type="submit"
          class="bg-red-500 text-white py-2 px-4 rounded hover:bg-red-600"
          onclick="
            return confirm('Are you sure you want to delete this item?');
          "
        >
          Delete Item
        </button>
      </form>
    </div>
  </body>
</html>
