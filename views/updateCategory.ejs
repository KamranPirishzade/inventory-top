<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit category · FigureStore</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="page">
      <form
        action="/categories/<%= categoryId %>/update"
        method="POST"
        class="card form-card flex flex-col gap-5"
      >
        <div>
          <h1 class="page-title">Edit category</h1>
          <p class="page-subtitle">
            Changes apply to every item in this category.
          </p>
        </div>

        <%- include('partials/formErrors') %>

        <div class="field">
          <label for="name" class="field-label">Name</label>
          <input
            type="text"
            name="name"
            id="name"
            required
            maxlength="100"
            class="field-input"
            value="<%= locals.values?.name || '' %>"
          />
        </div>

        <div class="field">
          <label for="description" class="field-label">Description</label>
          <textarea
            name="description"
            id="description"
            required
            maxlength="500"
            rows="4"
            class="field-input"
          >
<%= locals.values?.description || '' %></textarea
          >
        </div>

        <div class="field">
          <label for="name" class="field-label">Admin password</label>
          <input
            type="password"
            name="adminPassword"
            id="adminPassword"
            required
            maxlength="100"
            class="field-input"
          />
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <a href="/categories" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
      </form>
    </main>
  </body>
</html>
