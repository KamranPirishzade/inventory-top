<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Categories</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body class="p-4">
    <%- include('partials/header') %>
    <h1 class="text-2xl font-bold">Categories</h1>
    <section class="flex gap-4 mt-5">
    <% categories.forEach((category) => { %>
        <div class="p-4 border rounded-xl border-gray-300 mb-4 text-center">
            <h2><%= category.name %></h2>
            <p><%= category.description %></p>
            <a href="/items?category_id=<%= category.id %>" class="text-blue-500 hover:underline">View items</a>
            <a href="/categories/<%= category.id %>/update" class="text-blue-500 hover:underline ml-2">Edit</a>
            <form action="/categories/<%= category.id %>/delete" method="POST" class="inline">
                <button type="submit" onclick="return confirm('Are you sure you want to delete this category?');" class="text-red-500 hover:underline ml-2">Delete</button>
            </form>
            <% if (errorMessage && errorCategoryId === category.id) { %>
                <p class="text-red-500"><%= errorMessage %></p>
            <% } %>
        </div>
     <% }) %>
    </section>
    <a href="/categories/add" class="inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Add Category</a>
  </body>
</html>
