<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Categories · FigureStore</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="page">
      <div class="page-header">
        <div>
          <h1 class="page-title">Categories</h1>
          <p class="page-subtitle"><%= categories.length %> <%= categories.length === 1 ? 'category' : 'categories' %></p>
        </div>
        <a href="/categories/add" class="btn btn-primary">+ Add category</a>
      </div>

      <% if (categories.length === 0) { %>
        <div class="empty-state">
          <p class="font-medium text-gray-700">No categories yet.</p>
          <a href="/categories/add" class="btn btn-primary mt-4">+ Add category</a>
        </div>
      <% } else { %>
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% categories.forEach((category) => { %>
            <li class="card flex flex-col p-5">
              <h2 class="text-lg font-semibold text-gray-900"><%= category.name %></h2>
              <p class="mt-1 flex-1 text-sm text-gray-500"><%= category.description || 'No description.' %></p>

              <% if (errorMessage && errorCategoryId === category.id) { %>
                <p class="error-box mt-4" role="alert"><%= errorMessage %></p>
              <% } %>

              <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-gray-100 pt-4">
                <a href="/items?category_id=<%= category.id %>" class="btn-link">View items</a>
                <a href="/categories/<%= category.id %>/update" class="btn-link">Edit</a>
                <form action="/categories/<%= category.id %>/delete" method="POST" class="ml-auto">
                  <button
                    type="submit"
                    class="btn-link-danger"
                    onclick="return confirm('Are you sure you want to delete this category?')"
                  >Delete</button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
