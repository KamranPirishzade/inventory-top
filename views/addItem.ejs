<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add item · FigureStore</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="page">
      <form action="/items/add" method="POST" class="card form-card flex flex-col gap-5">
        <div>
          <h1 class="page-title">Add a new item</h1>
          <p class="page-subtitle">Fields without "optional" are required.</p>
        </div>

        <%- include('partials/formErrors') %>

        <div class="field">
          <label for="name" class="field-label">Name</label>
          <input
            type="text"
            name="name"
            id="name"
            required
            maxlength="100"
            class="field-input"
            value="<%= locals.values?.name || '' %>"
          />
        </div>

        <div class="field">
          <label for="description" class="field-label">Description <span class="field-hint">(optional)</span></label>
          <textarea
            name="description"
            id="description"
            maxlength="500"
            rows="4"
            class="field-input"
          ><%= locals.values?.description || '' %></textarea>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="field">
            <label for="category_id" class="field-label">Category</label>
            <select name="category_id" id="category_id" required class="field-input">
              <option value="">Choose a category</option>
              <% categories.forEach((c) => { %>
                <option value="<%= c.id %>" <%= String(c.id) === String(values?.category_id) ? "selected" : "" %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label for="brand_id" class="field-label">Brand</label>
            <select name="brand_id" id="brand_id" required class="field-input">
              <option value="">Choose a brand</option>
              <% brands?.forEach((b) => { %>
                <option value="<%= b.id %>" <%= String(b.id) === String(values?.brand_id) ? "selected" : "" %>><%= b.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label for="price" class="field-label">Price ($)</label>
            <input
              type="number"
              name="price"
              id="price"
              required
              min="0"
              step="0.01"
              class="field-input"
              value="<%= values?.price ?? '' %>"
            />
          </div>

          <div class="field">
            <label for="stock" class="field-label">Stock</label>
            <input
              type="number"
              name="stock"
              id="stock"
              required
              min="0"
              step="1"
              class="field-input"
              value="<%= values?.stock ?? '' %>"
            />
          </div>
        </div>

        <div class="field">
          <label for="img_url" class="field-label">Image URL <span class="field-hint">(optional)</span></label>
          <input
            type="url"
            name="img_url"
            id="img_url"
            placeholder="https://example.com/figure.jpg"
            class="field-input"
            value="<%= values?.img_url ?? '' %>"
          />
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <a href="/items" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary">Add item</button>
        </div>
      </form>
    </main>
  </body>
</html>
