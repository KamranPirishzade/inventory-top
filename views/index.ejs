<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Items · FigureStore</title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="page">
      <div class="page-header">
        <div>
          <h1 class="page-title">Inventory</h1>
          <p class="page-subtitle"><%= items.length %> <%= items.length === 1 ? 'item' : 'items' %></p>
        </div>
        <a href="/items/add" class="btn btn-primary">+ Add item</a>
      </div>

      <nav aria-label="Filter by category" class="mb-8">
        <ul class="flex flex-wrap gap-2">
          <li>
            <a href="/items" class="chip <%= selectedCategory === null ? 'chip-active' : '' %>">All</a>
          </li>
          <% categories.forEach(category => { %>
            <li>
              <a
                href="/items?category_id=<%= category.id %>"
                class="chip <%= Number(selectedCategory) === Number(category.id) ? 'chip-active' : '' %>"
              ><%= category.name %></a>
            </li>
          <% }); %>
        </ul>
      </nav>

      <% if (items.length === 0) { %>
        <div class="empty-state">
          <p class="font-medium text-gray-700">No items here yet.</p>
          <p class="mt-1 text-sm">Add the first one to get started.</p>
          <a href="/items/add" class="btn btn-primary mt-4">+ Add item</a>
        </div>
      <% } else { %>
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          <% items.forEach(item => { %>
            <li class="card flex flex-col overflow-hidden">
              <a href="/items/<%= item.id %>" class="block aspect-square bg-gray-100">
                <img
                  src="<% if (item.img_url) { %><%= item.img_url %><% } else { %>/images/default.png<% } %>"
                  alt="<%= item.name %>"
                  class="h-full w-full object-contain p-4"
                  loading="lazy"
                  onerror="this.src='/images/default.png'"
                />
              </a>
              <div class="flex flex-1 flex-col gap-2 p-4">
                <p class="text-xs text-gray-500"><%= item.brand_name %></p>
                <a href="/items/<%= item.id %>" class="font-semibold text-gray-900 hover:text-blue-600"><%= item.name %></a>
                <% if (item.description) { %>
                  <p class="line-clamp-2 text-sm text-gray-500"><%= item.description %></p>
                <% } %>
                <div class="mt-auto flex items-center justify-between pt-3">
                  <span class="text-lg font-bold text-gray-900">$<%= item.price %></span>
                  <% if (item.stock > 0) { %>
                    <span class="badge badge-success">In stock (<%= item.stock %>)</span>
                  <% } else { %>
                    <span class="badge badge-danger">Out of stock</span>
                  <% } %>
                </div>
                <a href="/items/<%= item.id %>/update" class="btn-link self-start">Edit</a>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
